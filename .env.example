# Meta WhatsApp Business Cloud API Credentials
ACCESS_TOKEN=your_system_user_or_temporary_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
WEBHOOK_VERIFY_TOKEN=your_custom_verify_token_here

# Outreach Limits
MONTHLY_LIMIT=800

# Server Config
PORT=3000

# Auto-Reply Message (sent when users reply within 24h window)
AUTO_REPLY_TEXT="Hello! Thank you for reaching out. We have received your message and will get back to you shortly."

